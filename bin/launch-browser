if [ "$1" = "--work" ]; then
  work=true
else
  work=false
fi

shift
if [ "$1" != "" ]; then
  URL="$1"
fi

if [ $work = true ]; then
  if [ "$URL" != "" ]; then
    google-chrome --profile-directory=Default "$URL"
  else
    google-chrome --profile-directory=Default
  fi
else
  if [ "$URL" != "" ]; then
    firefox --new-tab "$URL"
  else
    firefox
  fi
fi
